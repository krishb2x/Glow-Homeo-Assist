# HomeoAssist — copy to `.env` in this directory and fill values. One file for API + web.

# API
PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web (NEXT_PUBLIC_* are exposed to the browser)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Supabase (browser) — same project as API; used for sign-in, password reset, invite flow
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (Next /api/request → marketing_lead_requests). Same key as API; never expose to the browser.
# If set with NEXT_PUBLIC_SUPABASE_URL (or SUPABASE_URL), walkthrough/trial forms work without Express.
# Apply migrations: 20260428000000_marketing_lead_requests.sql then 20260503100000_marketing_leads_workspace.sql
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional duplicate of project URL for server-only code (defaults to NEXT_PUBLIC_SUPABASE_URL)
# SUPABASE_URL=https://your-project.supabase.co
# Public site origin for email links and middleware (dev: localhost; prod: your real URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API: redirect targets for admin invite / must match a URL in Supabase Auth → Redirect URLs
APP_PUBLIC_URL=http://localhost:3000
# Optional: override WebSocket base (defaults from NEXT_PUBLIC_API_URL)
# NEXT_PUBLIC_WS_URL=

# Marketing: app vs corporate site (intake pages, header links)
# NEXT_PUBLIC_APP_ORIGIN=https://app.glowhomeo.com
# NEXT_PUBLIC_MARKETING_ORIGIN=https://glowhomeo.com

# Next.js server-only (e.g. /api/ha-proxy → Express, POST /api/request → /public/marketing-lead)
API_URL=http://localhost:4000

# Optional
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# JWT_SECRET=
# Patient mobile login (patient_code on prescription). Defaults to JWT_SECRET if unset.
# PATIENT_AUTH_PEPPER=
# AWS_REGION= AWS_ACCESS_KEY_ID= AWS_SECRET_ACCESS_KEY= AWS_S3_PRIVATE_BUCKET=

# Prescription PDF (server-side Puppeteer render)
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Prescription delivery (Email via Resend, WhatsApp via Meta or Twilio fallback)
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFICATION_FROM_EMAIL=GlowHomeo Assist <noreply@glowhomeo.com>
# NOTIFICATION_REPLY_TO_EMAIL=care@glowhomeo.in
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
# TWILIO_ACCOUNT_SID= TWILIO_AUTH_TOKEN= TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# NOTIFICATION_MOCK_SEND=true

# WhatsApp Business (Meta Cloud API — per-doctor connection in Settings)
# WHATSAPP_SEND_INTERVAL_MS=1000
# NOTIFICATION_BATCH_LIMIT=50
# WHATSAPP_BATCH_LIMIT=30
# WHATSAPP_TOKEN_ENCRYPTION_KEY=
# META_WEBHOOK_VERIFY_TOKEN=
# WORKER_MODE=all
# WORKER_ID=api-1

# GlowHomeo platform WhatsApp — sends patient messages when doctor has not connected WABA
# PLATFORM_WHATSAPP_PHONE_NUMBER_ID=
# PLATFORM_WHATSAPP_ACCESS_TOKEN=
# PLATFORM_WHATSAPP_WABA_ID=
# PLATFORM_WHATSAPP_DISPLAY_PHONE=+91XXXXXXXXXX
# PLATFORM_WHATSAPP_ENABLED=true

# Meta Embedded Signup (WhatsApp Business OAuth)
# META_APP_ID=
# META_APP_SECRET=
# META_EMBEDDED_SIGNUP_CONFIG_ID=
# NEXT_PUBLIC_META_APP_ID=
# NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=

# Redis (optional — shared rate limits across API replicas)
# REDIS_URL=redis://localhost:6379
# RATE_PATIENT_SEARCH_PER_MIN=120
# RATE_WHATSAPP_BROADCAST_PER_MIN=10
# RATE_WHATSAPP_CONNECT_PER_MIN=5
# RATE_WHATSAPP_TEMPLATE_SYNC_PER_MIN=5

# Bootstrap script: SUPER_ADMIN_EMAIL SUPER_ADMIN_PASSWORD SUPER_ADMIN_FULL_NAME

# Telemedicine (Daily.co — required in production)
# DAILY_API_KEY=
# DAILY_DOMAIN=your-subdomain.daily.co
# DAILY_WEBHOOK_SECRET=
# DAILY_ROOM_PREFIX=GlowHomeo
# DAILY_MEETING_TOKEN_TTL_SEC=7200
# Register webhook URL: https://<api-host>/webhooks/daily
# Public join + Rx links use APP_PUBLIC_URL

# Meta WhatsApp webhook (production: META_APP_SECRET required for signature verification)
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=

# Patient mobile — Expo push (optional; mock send in dev via NOTIFICATION_MOCK_SEND)
# EXPO_ACCESS_TOKEN=

# Production hardening
# NODE_ENV=production
# NOTIFICATION_MOCK_SEND=false
# TRUST_PROXY=1
# REQUIRE_DAILY_IN_PROD=1
# REQUIRE_S3_IN_PROD=1
# REQUIRE_PLATFORM_WHATSAPP_IN_PROD=1
# LOGIN_MAX_ATTEMPTS_PER_15M=10
# RATE_PUBLIC_JOIN_PER_MIN=30
# RATE_PUBLIC_RX_PER_MIN=20
# MISSED_CONSULTATION_GRACE_MIN=20

# Production safety (never enable in prod)
# DEV_BYPASS_AUTH=true

# Razorpay Keys for MediTonic
MEDITONIC_RAZORPAY_KEY_ID=
MEDITONIC_RAZORPAY_KEY_SECRET=
MEDITONIC_RAZORPAY_WEBHOOK_SECRET=

# Shiprocket Credentials
SHIPROCKET_EMAIL=your-shiprocket-email@domain.com
SHIPROCKET_PASSWORD=your-shiprocket-password
